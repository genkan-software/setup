# cp .env.example .env  then change every value. Avoid ; = and quotes in passwords (they end up in connection strings).
GATEWAY_PORT=8080
# Combined Swagger UI of all services, served by the gateway on /swagger (true | false). Keep false in production.
SWAGGER_ENABLED=false
POSTGRES_PASSWORD=change-me-postgres
RABBITMQ_USER=genkan
RABBITMQ_PASSWORD=change-me-rabbit
REDIS_PASSWORD=change-me-redis
# First admin account, created on the first start of the auth service if no user exists (password >= 12 chars)
ADMIN_EMAIL=admin@genkan.local
ADMIN_PASSWORD=SuperSecureAdmin123!
FIREBASE_ENABLED=false
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase.json